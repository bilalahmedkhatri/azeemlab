# Server-only URL for THIS application; prefer a SELECT-only runtime role.
# Never prefix database settings with NEXT_PUBLIC_.
BLOG_DATABASE_URL=postgresql://blog_reader:CHANGE_ME@YOUR_DATABASE_HOST:5432/YOUR_DATABASE?sslmode=verify-full
# Set true for a pooler; prepared statements are always disabled.
BLOG_DATABASE_POOLER=false
# Use disable only for trusted local development.
BLOG_DATABASE_SSL=verify-full
# Exact HTTPS origins of registered public assets, comma-separated.
BLOG_MEDIA_ORIGINS=https://YOUR_BUCKET_HOST.backblazeb2.com
NEXT_PUBLIC_SITE_URL=https://www.azeemlab.com
# Public consumer needs no B2 credentials or upload configuration.
